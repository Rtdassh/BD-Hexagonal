rules_version = '2';

// Reglas de seguridad de la Clínica Odontológica.
// Aplican a clientes que se conectan directo a Firestore (web/móvil con Firebase Auth).
// El backend Flask usa el Admin SDK con una cuenta de servicio, que NO pasa por estas reglas;
// ahí la seguridad la aplica la API (autenticación + rol + filtro de información restringida).
// El rol viaja como custom claim en el token: request.auth.token.role

service cloud.firestore {
  match /databases/{database}/documents {

    function autenticado() { return request.auth != null; }
    function rol() { return request.auth.token.role; }
    function esPersonal() { return autenticado() && rol() in ['secretaria', 'odontologo', 'administrador']; }
    function esClinico() { return autenticado() && rol() in ['odontologo', 'administrador']; }

    // Formato de los datos (lo mismo que valida la API en src/domain/validaciones.py).
    // Los opcionales vacíos se guardan como "".
    function telefonoValido(t) { return t is string && (t == '' || t.matches('^[2-7][0-9]{3}-[0-9]{4}$')); }
    function pacienteValido(d) {
      return d.nombres is string && d.nombres.size() >= 2 && d.nombres.size() <= 50
        && d.apellidos is string && d.apellidos.size() >= 2 && d.apellidos.size() <= 50
        && d.dpi is string && d.dpi.matches('^[0-9]{13}$')
        && d.sexo in ['M', 'F']
        && d.fecha_nacimiento is string && d.fecha_nacimiento.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && (!('telefono' in d) || telefonoValido(d.telefono))
        && (!('direccion' in d) || (d.direccion is string && d.direccion.size() <= 200))
        && (!('correo_electronico' in d) || d.correo_electronico == ''
            || (d.correo_electronico is string && d.correo_electronico.size() <= 80
                && d.correo_electronico.matches('^[^@ ]+@[^@ ]+[.][^@ ]{2,}$')));
    }
    function profesionalValido(d) {
      return d.nombre_completo is string && d.nombre_completo.size() >= 2 && d.nombre_completo.size() <= 100
        && (!('telefono' in d) || telefonoValido(d.telefono));
    }

    // PÚBLICA: catálogo de procedimientos y odontólogos
    match /procedimientos_catalogo/{id} {
      allow read: if true;
      allow write: if esClinico();
    }
    match /catalogo_hallazgos/{id} {
      allow read: if true;
      allow write: if esClinico();
    }
    match /odontologos/{id} {
      allow read: if true;
      allow write: if esClinico() && profesionalValido(request.resource.data);
    }

    // CONFIDENCIAL: datos del paciente y agenda (la secretaria los gestiona)
    match /pacientes/{pacienteId} {
      allow read: if esPersonal();
      allow create: if esPersonal() && pacienteValido(request.resource.data);
      // La secretaria puede actualizar datos de contacto, pero no cambiar el estado del historial
      allow update: if pacienteValido(request.resource.data) && (esClinico()
        || (esPersonal() && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['historial', 'estado'])));
      allow delete: if false; // un historial nunca se borra, solo se archiva

      // RESTRINGIDA: consultas, diagnósticos, recetas y procedimientos por pieza
      match /consultas/{consultaId} {
        allow read, write: if esClinico();
        allow delete: if false;
      }
      // RESTRINGIDA: odontograma, un documento por pieza y cara ("46_O"); solo el clínico lo edita
      match /odontograma/{piezaCara} {
        allow read: if esPersonal();
        allow write: if esClinico() && request.resource.data.codigo_fdi is int
          && ((request.resource.data.codigo_fdi >= 11 && request.resource.data.codigo_fdi <= 48)
              || (request.resource.data.codigo_fdi >= 51 && request.resource.data.codigo_fdi <= 85))
          && request.resource.data.cara in ['O', 'V', 'L', 'M', 'D', 'G']
          && request.resource.data.estado in ['activo', 'tratado', 'en_observacion']
          && piezaCara == string(request.resource.data.codigo_fdi) + '_' + request.resource.data.cara;
        allow delete: if esClinico();
      }
      match /antecedente_sistemico/{doc} {
        allow read, write: if esClinico();
      }
    }
    match /citas/{citaId} {
      allow read, create, update: if esPersonal();
      allow delete: if false;
    }
    match /secretarias/{id} {
      allow read: if esPersonal();
      allow write: if esClinico();
    }
    match /colegiado_index/{colegiado} {
      allow read, create: if esPersonal();
      allow update, delete: if false;
    }
    match /dpi_index/{dpi} {
      allow read, create: if esPersonal();
      allow update, delete: if false;
    }
    // ---------------------------------------------------------------- Caja
    function facturaValida(d) {
      return d.numero_factura is string && d.numero_factura.matches('^CO-[0-9]{6}$')
        && d.monto_total is number && d.monto_total >= 0
        && d.monto_pagado is number && d.monto_pagado >= 0 && d.monto_pagado <= d.monto_total
        && d.estado in ['pendiente', 'parcial', 'pagada', 'anulada']
        && d.nit is string && d.nit.matches('^(CF|[0-9]{1,12}-?[0-9K])$')
        && d.detalle is list && d.detalle.size() >= 1 && d.detalle.size() <= 30;
    }
    match /facturas/{id} {
      allow read: if esPersonal();
      allow create: if esPersonal() && facturaValida(request.resource.data) && request.resource.data.monto_pagado == 0;
      // el detalle y el total no se cambian después de emitir; solo el pago y el estado
      allow update: if esPersonal() && facturaValida(request.resource.data)
        && request.resource.data.monto_total == resource.data.monto_total
        && request.resource.data.detalle == resource.data.detalle
        && resource.data.estado != 'anulada';
      allow delete: if false;
    }
    match /pagos/{id} {
      allow read: if esPersonal();
      allow create: if esPersonal() && request.resource.data.monto is number && request.resource.data.monto > 0
        && request.resource.data.metodo_pago in ['efectivo', 'tarjeta', 'transferencia', 'cheque']
        && request.resource.data.numero_recibo.matches('^R-CO-[0-9]{6}$');
      allow update, delete: if false; // un recibo emitido no se modifica
    }
    match /facturas_origen/{origen} {
      allow read, create, delete: if esPersonal();
      allow update: if false;
    }
    match /planes_tratamiento/{id} {
      allow read: if esPersonal();
      allow create, update: if esClinico() && request.resource.data.costo_total_estimado is number
        && request.resource.data.costo_total_estimado >= 0 && request.resource.data.etapas is list;
      allow delete: if false;
    }
    match /contadores/{nombre} {
      allow read, write: if esPersonal();
    }
  }
}
