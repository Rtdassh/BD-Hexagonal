rules_version = '2';

// Reglas de seguridad de la Clínica Odontológica.
// Aplican a clientes que se conectan directo a Firestore (web/móvil con Firebase Auth).
// El backend Flask usa el Admin SDK con una cuenta de servicio, que NO pasa por estas reglas;
// ahí la seguridad la aplica la API (autenticación + rol + filtro de información restringida).
// El rol viaja como custom claim en el token: request.auth.token.role

service cloud.firestore {
  match /databases/{database}/documents {

    function autenticado() { return request.auth != null; }
    function rol() { return request.auth.token.role; }
    function esPersonal() { return autenticado() && rol() in ['secretaria', 'odontologo', 'administrador']; }
    function esClinico() { return autenticado() && rol() in ['odontologo', 'administrador']; }

    // PÚBLICA: catálogo de procedimientos y odontólogos
    match /procedimientos_catalogo/{id} {
      allow read: if true;
      allow write: if esClinico();
    }
    match /odontologos/{id} {
      allow read: if true;
      allow write: if esClinico();
    }

    // CONFIDENCIAL: datos del paciente y agenda (la secretaria los gestiona)
    match /pacientes/{pacienteId} {
      allow read, create: if esPersonal();
      // La secretaria puede actualizar datos de contacto, pero no cambiar el estado del historial
      allow update: if esClinico()
        || (esPersonal() && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['historial', 'estado']));
      allow delete: if false; // un historial nunca se borra, solo se archiva

      // RESTRINGIDA: consultas, diagnósticos, recetas y procedimientos por pieza
      match /consultas/{consultaId} {
        allow read, write: if esClinico();
        allow delete: if false;
      }
    }
    match /citas/{citaId} {
      allow read, create, update: if esPersonal();
      allow delete: if false;
    }
    match /secretarias/{id} {
      allow read: if esPersonal();
      allow write: if esClinico();
    }
    match /colegiado_index/{colegiado} {
      allow read, create: if esPersonal();
      allow update, delete: if false;
    }
    match /dpi_index/{dpi} {
      allow read, create: if esPersonal();
      allow update, delete: if false;
    }
    match /contadores/{nombre} {
      allow read, write: if esPersonal();
    }
  }
}
