# Copie este archivo como .env y ajuste si cambió algo en docker-compose.yml
# auto = usa el motor real si responde; si no, usa el simulado en memoria
# live = exige los 4 motores reales (recomendado para la presentación)
ENGINE_MODE=auto
PORT=5000
SECRET_KEY=cambie-esta-clave

# PostgreSQL - Hospital General (usuario de mínimo privilegio creado por 02_seguridad_hospital.sql)
PG_HOST=localhost
PG_PORT=5433
PG_DATABASE=hospital_db
PG_USER=app_hospital
PG_PASSWORD=HospitalApp2026!

# MySQL - Centro Médico Pediátrico (usuario creado por 02_seguridad_pediatrico.sql)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_DATABASE=centro_pediatrico
MYSQL_USER=app_pediatrico
MYSQL_PASSWORD=PediatricoApp2026!

# MongoDB - Laboratorio Clínico (usuario creado por 01_init_laboratorio.js)
MONGO_URI=mongodb://app_laboratorio:LaboratorioApp2026!@localhost:27018/laboratorio_clinico?directConnection=true&authSource=laboratorio_clinico
MONGO_DATABASE=laboratorio_clinico

# Firebase - Clínica Odontológica
FIREBASE_PROJECT_ID=clinica-odontologica-landivar
# Opción A: emulador local (docker compose)
FIRESTORE_EMULATOR_HOST=localhost:8085
# Opción B: proyecto real de Firebase -> borre FIRESTORE_EMULATOR_HOST y ponga la ruta del JSON:
# FIREBASE_CREDENTIALS_PATH=C:/ruta/serviceAccountKey.json
